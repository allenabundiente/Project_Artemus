# Port for the API server (API_PORT wins over PORT)
API_PORT=4010

# ---------------------------------------------------------------------------
# LLM provider for challenge generation (pick ONE of the options below).
# With neither set, the app uses offline heuristic generation (no API calls).
# ---------------------------------------------------------------------------
# Option 1 (paid, best quality): Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Option 2 (FREE tiers): any OpenAI-compatible endpoint.
#   OpenRouter    → OPENAI_BASE_URL=https://openrouter.ai/api/v1
#                   key from https://openrouter.ai/settings/keys (models tagged ":free")
#                   e.g. LLM_MODEL=deepseek/deepseek-chat-v3:free
#   Google Gemini → OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                   key from https://aistudio.google.com/apikey
#                   e.g. LLM_MODEL=gemini-2.0-flash
#   Groq          → OPENAI_BASE_URL=https://api.groq.com/openai/v1
#                   key from https://console.groq.com/keys
#                   e.g. LLM_MODEL=llama-3.3-70b-versatile
#   Local Ollama  → OPENAI_BASE_URL=http://localhost:11434/v1  (any key works, e.g. "ollama")
#                   e.g. LLM_MODEL=qwen2.5-coder:7b
OPENAI_BASE_URL=
OPENAI_API_KEY=
LLM_MODEL=

# Supabase Postgres connection string.
# Supabase dashboard → Project Settings → Database → Connection string (URI).
# Use the "Connection pooling" (port 6543) string for serverless hosts, or the
# direct connection (port 5432) for this Express server. Example:
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=

# Secret used to sign JWT auth tokens — set a long random string in production.
JWT_SECRET=dev-secret-change-me
