# Port for the API server (API_PORT wins over PORT)
API_PORT=4010

# ---------------------------------------------------------------------------
# LLM provider for challenge generation (pick ONE of the options below).
# With neither set, the app uses offline heuristic generation (no API calls).
# ---------------------------------------------------------------------------
# Option 1 (paid, best quality): Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Option 2 (FREE tiers): any OpenAI-compatible endpoint.
#   OpenRouter    → OPENAI_BASE_URL=https://openrouter.ai/api/v1
#                   key from https://openrouter.ai/settings/keys (models tagged ":free")
#                   e.g. LLM_MODEL=deepseek/deepseek-chat-v3:free
#   Google Gemini → OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                   key from https://aistudio.google.com/apikey
#                   e.g. LLM_MODEL=gemini-2.0-flash
#   Groq          → OPENAI_BASE_URL=https://api.groq.com/openai/v1
#                   key from https://console.groq.com/keys
#                   e.g. LLM_MODEL=llama-3.3-70b-versatile
#   Local Ollama  → OPENAI_BASE_URL=http://localhost:11434/v1  (any key works, e.g. "ollama")
#                   e.g. LLM_MODEL=qwen2.5-coder:7b
OPENAI_BASE_URL=
OPENAI_API_KEY=
LLM_MODEL=

# Supabase Postgres connection string.
# Supabase dashboard → Project Settings → Database → Connection string (URI).
# Use a POOLED string. Supabase's direct host (db.[project-ref].supabase.co:5432)
# is IPv6-only, which unreachable hosts like Render cannot dial.
#   session mode     → pooler host, port 5432  (right for this long-lived server)
#   transaction mode → pooler host, port 6543  (serverless / many short connections)
# Examples:
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# (Local Postgres: postgresql://postgres@127.0.0.1:5432/questbook)
DATABASE_URL=

# Secret used to sign JWT auth tokens — set a long random string in production.
JWT_SECRET=dev-secret-change-me

# ---------------------------------------------------------------------------
# Optional third-party integrations (see src/services/integrations.ts).
# Leave anything blank and that feature quietly turns off — the app behaves
# exactly as before. /health reports which ones are active under "integrations".
# ---------------------------------------------------------------------------

# Judge0 — code runner
JUDGE0_URL=
JUDGE0_KEY=
JUDGE0_HOST=

# Cloudflare Turnstile — CAPTCHA (secret key)
TURNSTILE_SECRET=

# Resend — email
RESEND_API_KEY=
RESEND_FROM=QuestBook <noreply@yourdomain.com>

# Upstash Redis — cache + rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OCR.space — scanned PDFs
OCR_SPACE_API_KEY=

# LanguageTool (defaults to the public API; set for self-hosted/premium)
LANGUAGETOOL_URL=
LANGUAGETOOL_USER=
LANGUAGETOOL_KEY=

# LibreTranslate
LIBRETRANSLATE_URL=
LIBRETRANSLATE_KEY=

# OneSignal — web push
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# OpenAI Moderation (separate from OPENAI_API_KEY)
OPENAI_MODERATION_KEY=

# Sentry (also run: npm i @sentry/node)
SENTRY_DSN=
